# ===== PostgreSQL =====
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=football_predictor
POSTGRES_USER=football
# Cambiar en producción/entornos compartidos.
POSTGRES_PASSWORD=football

# ===== Fuente externa (Fase 7) =====
FOOTBALL_API_KEY=
FOOTBALL_API_BASE_URL=

# football-data.org (v4) - historico por competicion/temporada
FOOTBALL_DATA_API_KEY=
FOOTBALL_DATA_BASE_URL=https://api.football-data.org/v4

# football-charts.com - resultados/tablas, token gratis (5k req/dia)
FOOTBALL_CHARTS_API_KEY=
FOOTBALL_CHARTS_BASE_URL=https://footballcharts-backend.onrender.com/api/v1

# football98 via RapidAPI (X-RapidAPI-Key de tu cuenta RapidAPI)
FOOTBALL98_API_KEY=
FOOTBALL98_HOST=football98.p.rapidapi.com

# 5dollarfootballapi.com
FIVE_DOLLAR_API_KEY=
FIVE_DOLLAR_BASE_URL=https://api.5dollarfootballapi.com/v1

# playerelo.football - Team Elo (Bearer)
PLAYERELO_API_KEY=
PLAYERELO_BASE_URL=https://data-api.playerelo.football

# azharimm/football-standings-api (ESPN) - sin clave
STANDINGS_BASE_URL=https://football-standings-api.vercel.app

# ===== Modelos / Elo =====
ELO_INITIAL_RATING=1500
ELO_K_FACTOR=20
ELO_HOME_ADVANTAGE=60

# ===== Features =====
# Ventana para promedios de goles (dejar vacío = todo el historial).
# FEATURES_GOALS_WINDOW=
# Ventana para forma como local / como visitante.
# FEATURES_HOME_AWAY_WINDOW=5

# ===== Modelos =====
# Modelo Poisson: goles de empate (1.0 = sin corrección).
# MODELS_POISSON_DRAW_CORRECTION=1.0
# Regularización ridge sobre attack/defense del Poisson.
# MODELS_POISSON_REGULARIZATION=0.1
# Modelo Elo: prob. de empate máxima y dispersión según diferencia.
# MODELS_ELO_DRAW_MAX=0.30
# MODELS_ELO_DRAW_SIGMA=300
# Modelo ML: semilla fija.
# MODELS_ML_RANDOM_STATE=42
# Pesos del ensemble (poisson,elo,ml): se normalizan.
# MODELS_ENSEMBLE_WEIGHTS=0.4,0.3,0.3